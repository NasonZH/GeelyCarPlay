    <string name="settings_ui_scale">CarPlay 控件大小</string>
    <string name="settings_ui_scale_desc">只调整 CarPlay 内的图标和文字大小，不改分辨率与清晰度。</string>
    <string name="settings_resolution">分辨率</string>
    <string name="settings_resolution_desc">一般保持原生；仅在车机出现黑屏或裁剪时才调整。</string>
    <string name="settings_music_buffer">音乐缓冲</string>
    <string name="settings_music_buffer_desc">缓冲越小起播越快、延迟越低；无线不稳定时可调大。</string>
    <string name="settings_video_output">视频显示方式</string>
    <string name="settings_video_output_desc">自动优先 SurfaceView，初始化失败时回退兼容模式；重新进入投屏后生效。</string>
    <string name="settings_frame_rate">帧率</string>
    <string name="settings_frame_rate_desc">限制上限可减轻车机负载。</string>
    <string name="settings_hevc">高效视频编码</string>
    <string name="settings_hevc_desc">使用 HEVC。关闭后可兼容更多车机。</string>
