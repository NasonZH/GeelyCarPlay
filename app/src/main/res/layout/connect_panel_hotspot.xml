<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="@dimen/gap_xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="@dimen/panel_header_badge_size"
                android:layout_height="@dimen/panel_header_badge_size"
                android:background="@drawable/bg_icon_badge">

                <com.geely.carplay.ui.widget.IconView
                    android:layout_width="@dimen/panel_header_icon_size"
                    android:layout_height="@dimen/panel_header_icon_size"
                    android:layout_gravity="center"
                    app:icon="wifi"
                    app:iconTint="@color/brand" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_md"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/connect_step_hotspot" />

                <TextView
                    android:id="@+id/hotspot_state"
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_xs"
                    android:text="@string/connect_hotspot_on"
                    android:textColor="@color/ok" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_lg"
            android:background="@drawable/bg_card_high"
            android:orientation="vertical"
            android:padding="@dimen/gap_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="@dimen/gap_sm"
                android:paddingBottom="@dimen/gap_sm">

                <com.geely.carplay.ui.widget.IconView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    app:icon="wifi"
                    app:iconTint="@color/text_secondary" />

                <TextView
                    style="@style/Text.Caption"
                    android:layout_width="@dimen/hotspot_label_width"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_sm"
                    android:text="@string/connect_hotspot_ssid_label" />

                <TextView
                    style="@style/Text.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:id="@+id/hotspot_ssid"
                    android:text="@string/connect_hotspot_ssid"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@drawable/divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="@dimen/gap_sm"
                android:paddingBottom="@dimen/gap_sm">

                <com.geely.carplay.ui.widget.IconView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    app:icon="lock"
                    app:iconTint="@color/text_secondary" />

                <TextView
                    style="@style/Text.Caption"
                    android:layout_width="@dimen/hotspot_label_width"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_sm"
                    android:text="@string/connect_hotspot_pwd_label" />

                <TextView
                    style="@style/Text.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:id="@+id/hotspot_password"
                    android:text="@string/connect_hotspot_pwd"
                    android:textColor="@color/text_primary" />
            </LinearLayout>
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_md"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/hotspot_manual_button"
                style="@style/Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_height"
                android:paddingStart="@dimen/gap_md"
                android:paddingEnd="@dimen/gap_md"
                android:gravity="center"
                android:layout_marginEnd="@dimen/gap_md"
                android:background="@drawable/btn_ghost"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/hotspot_manual_title"
                android:textColor="@color/text_primary" />

            <FrameLayout
                android:id="@+id/hotspot_settings_button"
                android:layout_width="@dimen/action_button_width"
                android:layout_height="@dimen/touch_height"
                android:background="@drawable/btn_ghost"
                android:clickable="true"
                android:contentDescription="@string/btn_hotspot_settings"
                android:focusable="true">

                <com.geely.carplay.ui.widget.IconView
                    android:layout_width="@dimen/header_icon_size"
                    android:layout_height="@dimen/header_icon_size"
                    android:layout_gravity="center"
                    app:icon="gear"
                    app:iconTint="@color/text_primary" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
