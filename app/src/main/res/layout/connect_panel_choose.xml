<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/choose_wireless"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="@dimen/gap_xl">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="@dimen/panel_badge_size"
                    android:layout_height="@dimen/panel_badge_size"
                    android:background="@drawable/bg_icon_badge">

                    <com.geely.carplay.ui.widget.IconView
                        android:layout_width="@dimen/panel_badge_icon_size"
                        android:layout_height="@dimen/panel_badge_icon_size"
                        android:layout_gravity="center"
                        app:icon="wifi"
                        app:iconTint="@color/brand" />
                </FrameLayout>

                <TextView
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_md"
                    android:background="@drawable/bg_pill_brand"
                    android:paddingStart="@dimen/gap_md"
                    android:paddingTop="8dp"
                    android:paddingEnd="@dimen/gap_md"
                    android:paddingBottom="8dp"
                    android:text="@string/connect_recommended"
                    android:textColor="@color/brand" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                style="@style/Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/connect_wireless_title" />

            <TextView
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_sm"
                android:text="@string/connect_wireless_hint" />

            <TextView
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_md"
                android:text="@string/connect_wireless_meta" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/choose_usb"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/gap_lg"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="@dimen/gap_xl">

            <FrameLayout
                android:layout_width="@dimen/panel_badge_size"
                android:layout_height="@dimen/panel_badge_size"
                android:background="@drawable/bg_icon_badge">

                <com.geely.carplay.ui.widget.IconView
                    android:layout_width="@dimen/panel_badge_icon_size"
                    android:layout_height="@dimen/panel_badge_icon_size"
                    android:layout_gravity="center"
                    app:icon="usb"
                    app:iconTint="@color/text_secondary" />
            </FrameLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                style="@style/Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/connect_usb_title" />

            <TextView
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_sm"
                android:text="@string/connect_usb_hint" />

            <TextView
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_md"
                android:text="@string/connect_usb_meta" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
