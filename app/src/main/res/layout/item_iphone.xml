<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/gap_sm"
    android:background="@drawable/bg_iphone"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/phone_min_height"
    android:orientation="horizontal"
    android:paddingStart="@dimen/gap_md"
    android:paddingEnd="@dimen/gap_md">

    <FrameLayout
        android:layout_width="@dimen/step_circle_size"
        android:layout_height="@dimen/step_circle_size"
        android:background="@drawable/bg_icon_round_muted">

        <com.geely.carplay.ui.widget.IconView
            android:layout_width="@dimen/step_icon_size"
            android:layout_height="@dimen/step_icon_size"
            android:layout_gravity="center"
            app:icon="phone"
            app:iconTint="@color/text_primary" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gap_md"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/iphone_name"
            style="@style/Text.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/iphone_state"
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_xs" />
    </LinearLayout>

    <TextView
        style="@style/Text.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/connect_iphone_action"
        android:textColor="@color/brand" />
</LinearLayout>
