<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/step_min_height"
    android:orientation="horizontal"
    android:paddingStart="@dimen/gap_sm"
    android:paddingTop="@dimen/gap_sm"
    android:paddingEnd="@dimen/gap_sm"
    android:paddingBottom="@dimen/gap_sm">

    <FrameLayout
        android:id="@+id/step_circle"
        android:layout_width="@dimen/step_circle_size"
        android:layout_height="@dimen/step_circle_size"
        android:background="@drawable/bg_step_pending">

        <com.geely.carplay.ui.widget.IconView
            android:id="@+id/step_icon"
            android:layout_width="@dimen/step_icon_size"
            android:layout_height="@dimen/step_icon_size"
            android:layout_gravity="center"
            app:icon="phone"
            app:iconTint="@color/text_secondary" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gap_md"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/step_title"
            style="@style/Text.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/step_state"
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_xs" />
    </LinearLayout>
</LinearLayout>
