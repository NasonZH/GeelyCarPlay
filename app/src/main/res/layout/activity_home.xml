<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_page"
    android:orientation="vertical">

    <!-- 顶栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/topbar_height"
        android:paddingTop="@dimen/gap_xs"
        android:paddingBottom="@dimen/gap_xs"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/page_padding"
        android:paddingEnd="@dimen/gap_sm">

        <ImageView
            android:layout_width="@dimen/header_logo_size"
            android:layout_height="@dimen/header_logo_size"
            android:contentDescription="@string/app_name"
            android:src="@drawable/app_logo" />

        <TextView
            style="@style/Text.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gap_sm"
            android:id="@+id/home_app_title"
            android:text="@string/app_name" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/home_clock"
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/gap_sm"
            android:background="@drawable/bg_pill_outline"
            android:paddingStart="@dimen/gap_md"
            android:paddingTop="9dp"
            android:paddingEnd="@dimen/gap_md"
            android:paddingBottom="9dp"
            android:textColor="@color/text_primary" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/gap_sm"
            android:background="@drawable/bg_pill_outline"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/gap_md"
            android:paddingTop="9dp"
            android:paddingEnd="@dimen/gap_md"
            android:paddingBottom="9dp">

            <com.geely.carplay.ui.widget.IconView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:id="@+id/home_hotspot_icon"
                app:icon="wifi"
                app:iconTint="@color/ok" />

            <TextView
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_xs"
                android:id="@+id/home_hotspot_state"
                android:text="@string/home_hotspot_state"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/gap_xs"
            android:background="@drawable/bg_pill_outline"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/gap_md"
            android:paddingTop="9dp"
            android:paddingEnd="@dimen/gap_md"
            android:paddingBottom="9dp">

            <com.geely.carplay.ui.widget.IconView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:id="@+id/home_bluetooth_icon"
                app:icon="bluetooth"
                app:iconTint="@color/ok" />

            <TextView
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_xs"
                android:id="@+id/home_bluetooth_state"
                android:text="@string/status_bluetooth"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/home_settings_button"
            android:layout_width="@dimen/header_action_size"
            android:layout_height="@dimen/header_action_size"
            android:clickable="true"
            android:contentDescription="@string/home_settings_title"
            android:focusable="true">

            <com.geely.carplay.ui.widget.IconView
                android:layout_width="@dimen/header_icon_size"
                android:layout_height="@dimen/header_icon_size"
                android:layout_gravity="center"
                app:icon="gear"
                app:iconTint="@color/text_secondary" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/home_exit"
            android:layout_width="@dimen/header_action_size"
            android:layout_height="@dimen/header_action_size"
            android:clickable="true"
            android:contentDescription="@string/btn_exit_to_head_unit"
            android:focusable="true">

            <com.geely.carplay.ui.widget.IconView
                android:layout_width="@dimen/header_icon_size"
                android:layout_height="@dimen/header_icon_size"
                android:layout_gravity="center"
                app:icon="exit"
                app:iconTint="@color/text_secondary" />
        </FrameLayout>
    </LinearLayout>

    <!-- 主体：单张卡片 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/page_padding"
        android:layout_marginTop="@dimen/gap_md"
        android:layout_marginEnd="@dimen/page_padding"
        android:layout_marginBottom="@dimen/page_padding"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:padding="@dimen/gap_xl"
        android:background="@drawable/bg_card">


        <ScrollView
            android:id="@+id/home_content_scroll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_brand"
                    android:paddingStart="@dimen/gap_md"
                    android:paddingTop="8dp"
                    android:paddingEnd="@dimen/gap_md"
                    android:paddingBottom="8dp"
                    android:text="@string/home_wireless_title"
                    android:textColor="@color/brand" />

                <TextView
                    android:id="@+id/home_state"
                    style="@style/Text.Display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_md"
                    android:text="@string/home_wireless_state" />

                <TextView
                    android:id="@+id/home_hint"
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_sm"
                    android:text="@string/home_wireless_hint" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_lg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.geely.carplay.ui.widget.IconView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        app:icon="phone"
                        app:iconTint="@color/text_secondary" />

                    <TextView
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/gap_sm"
                        android:text="@string/home_last_device"
                        android:textColor="@color/text_secondary" />

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginStart="@dimen/gap_sm"
                        android:layout_marginEnd="@dimen/gap_sm"
                        android:background="@drawable/dot_ok" />

                    <TextView
                        android:id="@+id/home_device"
                        style="@style/Text.Caption"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:layout_height="wrap_content"
                        android:text="@string/home_last_device_state"
                        android:textColor="@color/ok" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/home_connect_button"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_height"
                    android:layout_marginTop="@dimen/home_action_margin"
                    android:background="@drawable/btn_primary"
                    android:clickable="true"
                    android:contentDescription="@string/btn_connect_phone"
                    android:focusable="true">

                    <com.geely.carplay.ui.widget.IconView
                        android:layout_width="@dimen/header_icon_size"
                        android:layout_height="@dimen/header_icon_size"
                        android:layout_gravity="center"
                        app:icon="link"
                        app:iconTint="@color/white" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/home_connected_actions"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_height"
                    android:layout_marginTop="@dimen/home_action_margin"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <FrameLayout
                        android:id="@+id/home_enter_carplay"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/btn_primary"
                        android:clickable="true"
                        android:contentDescription="@string/btn_enter_carplay"
                        android:focusable="true">

                        <com.geely.carplay.ui.widget.IconView
                            android:layout_width="@dimen/header_icon_size"
                            android:layout_height="@dimen/header_icon_size"
                            android:layout_gravity="center"
                            app:icon="play"
                            app:iconTint="@color/white" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/home_disconnect"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/gap_md"
                        android:layout_weight="1"
                        android:background="@drawable/btn_ghost"
                        android:clickable="true"
                        android:contentDescription="@string/btn_disconnect"
                        android:focusable="true">

                        <com.geely.carplay.ui.widget.IconView
                            android:layout_width="@dimen/header_icon_size"
                            android:layout_height="@dimen/header_icon_size"
                            android:layout_gravity="center"
                            app:icon="power"
                            app:iconTint="@color/text_primary" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <com.geely.carplay.ui.widget.CarPlayPreviewView
            android:id="@+id/home_preview"
            android:layout_width="0dp"
            android:layout_height="@dimen/home_preview_height"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/gap_lg" />
    </LinearLayout>
</LinearLayout>
