<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/setting_min_height"
    android:orientation="horizontal"
    android:paddingStart="@dimen/gap_md"
    android:paddingTop="@dimen/gap_md"
    android:paddingEnd="@dimen/gap_md"
    android:paddingBottom="@dimen/gap_md">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_title"
            style="@style/Text.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/row_desc"
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_xs" />
    </LinearLayout>

    <TextView
        android:maxWidth="@dimen/setting_value_max_width"
        android:id="@+id/row_value"
        style="@style/Text.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gap_md"
        android:textColor="@color/text_primary"
        android:visibility="gone" />

    <TextView
        android:id="@+id/row_arrow"
        style="@style/Text.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gap_sm"
        android:text="@string/row_arrow"
        android:textColor="@color/text_tertiary"
        android:visibility="gone" />

    <com.geely.carplay.ui.widget.CarPlaySwitch
        android:id="@+id/row_switch"
        android:layout_width="@dimen/switch_width"
        android:layout_height="@dimen/switch_height"
        android:layout_marginStart="@dimen/gap_md"
        android:visibility="gone" />
</LinearLayout>
