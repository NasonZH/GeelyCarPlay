<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_page"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/topbar_height"
        android:paddingTop="@dimen/gap_xs"
        android:paddingBottom="@dimen/gap_xs"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/page_padding"
        android:paddingEnd="@dimen/page_padding">

        <FrameLayout
            android:id="@+id/connect_back"
            android:layout_width="@dimen/back_button_width"
            android:layout_height="@dimen/back_button_height"
            android:background="@drawable/btn_ghost"
            android:clickable="true"
            android:contentDescription="@string/btn_back"
            android:focusable="true">

            <com.geely.carplay.ui.widget.IconView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                app:icon="arrowLeft"
                app:iconTint="@color/text_primary" />
        </FrameLayout>

        <TextView
            style="@style/Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gap_md"
            android:text="@string/connect_title" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/connect_mode_label"
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_outline"
            android:paddingStart="@dimen/gap_md"
            android:paddingTop="10dp"
            android:paddingEnd="@dimen/gap_md"
            android:paddingBottom="10dp"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="@dimen/page_padding"
        android:paddingTop="@dimen/gap_md"
        android:paddingEnd="@dimen/page_padding">

        <ScrollView
            android:id="@+id/connect_sidebar_scroll"
            android:layout_width="@dimen/connect_sidebar_width"
            android:layout_height="match_parent"
            android:scrollbars="vertical">
            <LinearLayout
                android:id="@+id/connect_steps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/gap_lg"
            android:layout_weight="1"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <include
                    android:id="@+id/panel_choose"
                    layout="@layout/connect_panel_choose"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <include
                    android:id="@+id/panel_hotspot"
                    layout="@layout/connect_panel_hotspot"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <include
                    android:id="@+id/panel_phone"
                    layout="@layout/connect_panel_phone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <include
                    android:id="@+id/panel_link"
                    layout="@layout/connect_panel_link"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/connect_action"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_height"
                android:layout_marginTop="@dimen/gap_md"
                android:background="@drawable/btn_primary"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.geely.carplay.ui.widget.IconView
                        android:id="@+id/connect_action_icon"
                        android:layout_width="@dimen/header_icon_size"
                        android:layout_height="@dimen/header_icon_size"
                        app:icon="arrowRight"
                        app:iconTint="@color/white" />

                    <TextView
                        android:id="@+id/connect_action_label"
                        style="@style/Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/gap_sm"
                        android:textColor="@color/white" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/connect_action_hint"
        style="@style/Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/page_padding"
        android:paddingTop="@dimen/gap_sm"
        android:paddingEnd="@dimen/page_padding"
        android:paddingBottom="@dimen/gap_md" />
</LinearLayout>
